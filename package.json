{
  "name": "salonplattform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "dev:bestellung": "vite --config vite.bestellung.config.ts",
    "build:bestellung": "tsc -b && vite build --config vite.bestellung.config.ts",
    "preview:bestellung": "vite preview --config vite.bestellung.config.ts",
    "dev:bestellung:test": "vite --config vite.bestellung.config.ts --mode testversion",
    "build:bestellung:test": "tsc -b && vite build --config vite.bestellung.config.ts --mode testversion"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "@vimeo/player": "^2.30.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
